# Copy to .env and fill in real values. NEVER commit the real .env.

# --- Database ---
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Session ---
# Must be >= 32 characters. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# Set to "false" only for local HTTP development.
HTTPS_ONLY=true

# --- Discord OAuth ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://your-domain/callback
DISCORD_GUILD_ID=
# Comma-separated role IDs allowed to access the dashboard.
REQUIRED_ROLE_ID=
# Comma-separated role IDs explicitly denied (takes priority over REQUIRED_ROLE_ID).
DENY_ROLE_IDS=
# Comma-separated Discord user IDs with admin access.
ADMIN_USER_IDS=
# Role granting "active informant" status.
ACTIVE_INFORMANT_ROLE_ID=
# Comma-separated role_id:max_position pairs (positions 1-8 = weeks, 9-12 = 3m/4m/5m/6m).
LOOKBACK_ROLE_WEEKS=

# --- Third-party APIs ---
GOOGLE_MAPS_API_KEY=
ANTHROPIC_API_KEY=
POKEMON_TCG_API_KEY=
# JustTCG (card tracker pricing) — free tier: 1,000 calls/month.
JUSTTCG_API_KEY=
