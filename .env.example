# Copy to .env and fill in real values. NEVER commit the real .env.

# --- Database ---
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Session ---
# Must be >= 32 characters. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# Set to "false" only for local HTTP development.
HTTPS_ONLY=true

# --- Discord OAuth ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://your-domain/callback
DISCORD_GUILD_ID=
# Comma-separated role IDs allowed to access the dashboard.
REQUIRED_ROLE_ID=
# Comma-separated role IDs explicitly denied (takes priority over REQUIRED_ROLE_ID).
DENY_ROLE_IDS=
# Comma-separated Discord user IDs with admin access.
ADMIN_USER_IDS=
# Comma-separated role IDs for the mod-only pages (card tracker, sample previews).
MOD_ROLE_IDS=
# Comma-separated role IDs for the "all_mods" role-management group. Opens the
# invite-network page beyond admins. Separate from MOD_ROLE_IDS — roles here do
# NOT gain the mod-only pages.
ALL_MODS_ROLE_IDS=
# Role granting "active informant" status.
ACTIVE_INFORMANT_ROLE_ID=
# Comma-separated role_id:max_position pairs (positions 1-8 = weeks, 9-12 = 3m/4m/5m/6m).
LOOKBACK_ROLE_WEEKS=

# --- Third-party APIs ---
GOOGLE_MAPS_API_KEY=
ANTHROPIC_API_KEY=
POKEMON_TCG_API_KEY=
# JustTCG (card tracker pricing) — free tier: 1,000 calls/month.
JUSTTCG_API_KEY=
# Optional backup key: the client fails over automatically when the primary
# runs out of quota (or is rejected).
JUSTTCG_API_KEY_2=
# Riftbound cards and sealed product (TCGGO's "Riftbound Prices API" on
# RapidAPI). A full daily refresh is ~95 requests, so it needs the Pro plan
# (2,500/day); the free plan's 100/day can't cover it. Unset = no Riftbound.
RIFTBOUND_API_KEY=
# Lorcana cards and prices come from Lorcast (lorcast.com), which needs no
# key. The daily update is on by default; set this to 1 to switch it off.
LORCANA_SYNC_DISABLED=
# Gundam cards and prices come from TCGCSV (tcgcsv.com), which needs no key.
# The daily update is on by default; set GUNDAM_SYNC_DISABLED to 1 to switch it
# off. TCGCSV asks for a User-Agent that names the application and may block
# generic ones, so set GUNDAM_USER_AGENT to something like "YourSite/1.0".
GUNDAM_SYNC_DISABLED=
GUNDAM_USER_AGENT=
